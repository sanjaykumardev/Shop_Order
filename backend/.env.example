# Copy this file to .env and fill in your real values. Never commit .env.

# REQUIRED. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Must be False in production (never expose errors/tracebacks to clients).
DEBUG=False

# Comma-separated hostnames that may serve this app. Include your real domain in production.
# Render free instances live at <name>.onrender.com, covered by the ".onrender.com" entry below.
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# REQUIRED. Supabase Postgres connection string.
# Find it in your Supabase project: Settings -> Database -> Connection string -> URI.
# Use the direct connection (port 5432) if you're running Django somewhere long-lived,
# or the "Transaction pooler" (port 6543) for serverless/most setups.
# Example:
# DATABASE_URL=postgresql://postgres.abcdefghijk:[email protected]:5432/postgres
DATABASE_URL=

# Comma-separated frontend origins allowed to call the API.
# Add your deployed frontend URL in production.
# Vercel production + preview (*.vercel.app) URLs are allowed automatically.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# Comma-separated origins allowed to POST (Django admin/CSRF). Usually the same as CORS.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
